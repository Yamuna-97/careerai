# ================================================
# CareerAI Backend — Environment Variables Template
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── Supabase PostgreSQL ────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# Make sure to replace [YOUR-PASSWORD] with your actual DB password
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase Project ────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── App Settings ────────────────────────────────
APP_NAME=CareerAI Backend
APP_VERSION=1.0.0
DEBUG=True

# ─── CORS ────────────────────────────────────────
# Frontend development server URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI Provider (optional — fill later) ─────────
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.5-flash-lite

# ─── Supabase JWKS (for ES256 JWT verification) ──
# Format: https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# ─── JSearch Job Search API (openwebninja.com) ───
# Optional: Get a free API key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key_here
